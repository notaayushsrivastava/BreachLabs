# BreachLabs environment configuration (example)
# Copy to .env and adjust.

# Assessment API bind address
BREACHLABS_HOST=127.0.0.1
BREACHLABS_PORT=8000

# Default port used for the isolated target application
BREACHLABS_TARGET_PORT=5000

# Optional: LLM provider key for agentic triage (deterministic fallback is used when unset)
BREACHLABS_LLM_API_KEY=
